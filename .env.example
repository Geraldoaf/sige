# ==============================================================================
# SIGE - Sandbox de Isolamento para Execução de Código
# Configurações de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO
# ------------------------------------------------------------------------------
# Chave de acesso à API. Se vazia, uma nova chave será gerada e salva no volume persistido.
SIGE_API_KEY=

# Permite chamadas sem autenticação (AVISO: use apenas em desenvolvimento local)
SIGE_ALLOW_UNAUTHENTICATED=false

# IPs de proxies reversos confiáveis separados por vírgula (para validação do X-Real-IP)
SIGE_TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# MODO DE OPERAÇÃO E CONCORRÊNCIA
# ------------------------------------------------------------------------------
# Modo de avaliação padrão da API: interpreter | single_evaluation | multi_evaluation
SIGE_API_MODE=interpreter

# Número máximo global de sandboxes executando simultaneamente no servidor
SIGE_MAX_CONCURRENT_SANDBOXES=8

# ------------------------------------------------------------------------------
# LIMITES PADRÃO POR EXECUÇÃO (Para requisições sem limites explícitos)
# ------------------------------------------------------------------------------
# Limite de memória RAM por sandbox (em MB)
SIGE_MEMORY_MB=50

# Cota de CPU permitida (ex: 50% ou 100)
SIGE_CPU=50%

# Tempo limite de execução (em segundos)
SIGE_TIMEOUT_SEC=5

# Limite de espaço em disco no /tmp efêmero tmpfs (em MB)
SIGE_TMP_LIMIT_MB=64

# Tamanho máximo de qualquer arquivo gravado pelo processo (em MB)
SIGE_MAX_FILE_SIZE_MB=15

# Quantidade máxima de descritores de arquivos abertos simultâneos
SIGE_MAX_OPEN_FILES=256

# ------------------------------------------------------------------------------
# TETOS MÁXIMOS DO SERVIDOR (CEILINGS)
# Valores máximos inquebráveis que uma requisição pode solicitar
# ------------------------------------------------------------------------------
SIGE_CEILING_MEMORY_MB=512
SIGE_CEILING_CPU_PERCENT=100
SIGE_CEILING_TIMEOUT_SEC=30
SIGE_CEILING_TMP_LIMIT_MB=256
SIGE_CEILING_MAX_FILE_SIZE_MB=64
SIGE_CEILING_MAX_OPEN_FILES=512
